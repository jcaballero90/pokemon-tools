# Copy to caddy.env on the mini PC; owner root, mode 0600.
# Numeric container process identity; matches the mini PC utilities account.
CADDY_UID='1003'
CADDY_GID='1003'

# Hostnames have no scheme or trailing slash. Keep them consistent with the
# staging and production files and your DuckDNS/Tailscale configuration.
PUBLIC_HOST='replace-me.duckdns.org'
STAGING_HOST='pokemon-staging.replace-tailnet.ts.net'
FUNNEL_HOST='replace-mini-pc.replace-tailnet.ts.net'
ACME_EMAIL='replace-me@example.com'

# Starting value from caddy.yaml. Verify the exact peer observed by Caddy
# for Tailscale requests on the actual host before enabling production.
TAILSCALE_PROXY_PEER='172.31.10.1'
