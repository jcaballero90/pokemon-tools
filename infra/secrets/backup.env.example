# Copy to backup.env on the mini PC; owner root, mode 0600.
# Sourced by the Bash backup and restore scripts; use literal quoted values.
USB_MOUNT='/mnt/pokemon-backup'
# The repository must be beneath USB_MOUNT.
RESTIC_REPOSITORY='/mnt/pokemon-backup/restic'
# Create a separate root-only file containing a random restic password.
# Keep the password outside the USB device and retain a recovery copy.
RESTIC_PASSWORD_FILE='/opt/pokemon-tools/infra/secrets/restic-password'
