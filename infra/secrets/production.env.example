# Copy to production.env on the mini PC; owner root, mode 0600.
# Docker Compose reads this file and deploy.sh sources it as Bash.
# Use single-quoted literal values, without references to other variables.

# Use secrets distinct from staging, for example with openssl rand -hex 32.
# DB_PASSWORD must match the password in DATABASE_URL. Percent-encode reserved
# characters in the URL password; hex passwords need no encoding.
# Choose the password before the database volume is first initialized.
DB_PASSWORD='replace-with-a-random-production-db-password'
DATABASE_URL='postgresql://pokemon:replace-with-a-random-production-db-password@db:5432/pokemon'
BETTER_AUTH_SECRET='replace-with-a-random-production-auth-secret-of-at-least-32-characters'

# PUBLIC_HOST must match caddy.env and has no scheme or trailing slash.
PUBLIC_HOST='replace-me.duckdns.org'
FUNNEL_BASE_URL='https://replace-mini-pc.replace-tailnet.ts.net:8443'
# Use the working primary public URL. If using Funnel as primary, replace
# this value with the same literal URL as FUNNEL_BASE_URL.
PUBLIC_BASE_URL='https://replace-me.duckdns.org'

# Optional email transport. EMAIL_FROM is a bare sender email address.
SMTP_URL=''
EMAIL_FROM=''

# IMAGE_DIGEST is supplied by pokemon-deploy from the tested staging release.
# For database-only preparation before that release, see docs/operations.md.
