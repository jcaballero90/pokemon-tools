# Copy to staging.env on the mini PC; owner root, mode 0600.
# Docker Compose reads this file and deploy.sh sources it as Bash.
# Use single-quoted literal values, without references to other variables.

# Generate independent random secrets, for example with openssl rand -hex 32.
# DB_PASSWORD must match the password in DATABASE_URL. Percent-encode reserved
# characters in the URL password; hex passwords need no encoding.
# Choose the password before the database volume is first initialized.
DB_PASSWORD='replace-with-a-random-staging-db-password'
DATABASE_URL='postgresql://pokemon:replace-with-a-random-staging-db-password@db:5432/pokemon'
BETTER_AUTH_SECRET='replace-with-a-random-staging-auth-secret-of-at-least-32-characters'

# Private Tailscale staging service; STAGING_HOST must also match caddy.env.
STAGING_BASE_URL='https://pokemon-staging.replace-tailnet.ts.net'
STAGING_HOST='pokemon-staging.replace-tailnet.ts.net'

# Optional email transport. EMAIL_FROM is a bare sender email address.
SMTP_URL=''
EMAIL_FROM=''

# IMAGE_DIGEST is supplied by pokemon-deploy from the staging CI build.
# For database-only preparation before that build, see docs/operations.md.
