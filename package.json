{
  "name": "pokemon-tools",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.11 <25"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @pokemon-tools/api --filter @pokemon-tools/web dev",
    "build": "pnpm --filter @pokemon-tools/contracts build && pnpm --filter @pokemon-tools/web build && pnpm --filter @pokemon-tools/api build",
    "check": "pnpm --filter @pokemon-tools/contracts build && pnpm -r check",
    "lint": "eslint .",
    "config:check": "node scripts/check-config.mjs",
    "test": "pnpm --filter @pokemon-tools/contracts build && pnpm -r test",
    "test:e2e": "pnpm --filter @pokemon-tools/web test:e2e",
    "db:generate": "pnpm --filter @pokemon-tools/api db:generate",
    "db:validate": "pnpm --filter @pokemon-tools/api db:validate",
    "db:migrate": "pnpm --filter @pokemon-tools/api db:migrate"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "typescript-eslint": "8.70.1",
    "yaml": "2.9.1"
  }
}
